# 이 파일을 .env로 복사한 뒤 값을 채워 주세요. .env는 git에 올라가지 않아요.

# 페이스북 페이지 ID (페이지 정보 > 페이지 투명성 또는 Graph API Explorer에서 확인)
META_PAGE_ID=

# 장기 페이지 액세스 토큰 (가능하면 시스템 사용자 토큰)
# 필요한 권한: pages_messaging, pages_manage_metadata, pages_read_engagement,
#              instagram_basic, instagram_manage_messages
META_PAGE_TOKEN=

# 페이지에 연결된 인스타그램 프로페셔널 계정 ID (비워두면 자동으로 찾아요)
META_IG_USER_ID=

# true면 실제로 보내지 않고 미리보기만 해요. 테스트가 끝나면 false로 바꾸세요.
META_DRY_RUN=true

# Graph API 버전 (Meta 개발자 문서에서 최신 버전을 확인해 고정하세요)
META_GRAPH_VERSION=v24.0

# 발송 간 최소 간격(초)과 시간당 최대 발송 수
META_MIN_SEND_INTERVAL_SEC=5
META_MAX_SENDS_PER_HOUR=30
